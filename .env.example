# Copie este arquivo para ".env" na raiz do projeto e preencha com as
# credenciais do SEU MySQL. O ".env" não vai para o GitHub.

# Conexão com o banco (obrigatórias)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=BIBLIOTECA_BD

# Opcionais
# DB_PORT=3306          # só mude se o banco não estiver na porta 3306 (MySQL hospedado)
# DB_SSL=true           # só se o banco hospedado exigir conexão criptografada
# PORT=3000             # porta em que o servidor escuta
# HOST=127.0.0.1        # use 0.0.0.0 quando o site estiver hospedado (Railway, VPS...)
# DIAS_EMPRESTIMO=14
# DEV_EMAIL=dev@gmail.com
# DEV_SENHA=1234devs
